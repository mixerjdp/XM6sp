	void FASTCALL IntCancel(int level);
										// Š„‚èž‚ÝƒLƒƒƒ“ƒZƒ‹
	DWORD FASTCALL GetCycle() const		{ return ::s68000readOdometer(); }
										// ƒTƒCƒNƒ‹”Žæ“¾
	DWORD FASTCALL GetPC() const		{ return ::s68000readPC(); }
