		DWORD areg[8];					// ƒAƒhƒŒƒXƒŒƒWƒXƒ^
		DWORD sp;						// ƒXƒ^ƒbƒN—\”õ(USP or SSP)
		DWORD pc;						// ƒvƒƒOƒ‰ƒ€ƒJƒEƒ“ƒ^
		DWORD intr[8];					// Š„‚èž‚Ýî•ñ
		DWORD sr;						// ƒXƒe[ƒ^ƒXƒŒƒWƒXƒ^
		DWORD intreq[8];				// Š„‚èž‚Ý—v‹‰ñ”
		DWORD intack[8];				// Š„‚èž‚ÝŽó—‰ñ”
		DWORD odd;						// ŽÀsƒJƒEƒ“ƒ^
	} cpu_t;

	typedef struct {
		DWORD erraddr;					// ƒGƒ‰[ƒAƒhƒŒƒX
		DWORD errtime;					// ƒGƒ‰[Žž‚Ì‰¼‘zŽžŠÔ
		DWORD intreq[8];				// Š„‚èž‚Ý—v‹‰ñ”
		DWORD intack[8];				// Š„‚èž‚ÝŽó—‰ñ”
	} cpusub_t;

public:
	// Šî–{ƒtƒ@ƒ“ƒNƒVƒ‡ƒ“
	CPU(VM *p);
