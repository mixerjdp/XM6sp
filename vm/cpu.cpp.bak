	Device::Cleanup();
}

//---------------------------------------------------------------------------
//
//	ƒŠƒZƒbƒg
//
//---------------------------------------------------------------------------
void FASTCALL CPU::Reset()
{
	int i;
	S68000CONTEXT context;
	DWORD bit;

	ASSERT(this);
	LOG0(Log::Normal, "ƒŠƒZƒbƒg");

	// ƒGƒ‰[ƒAƒhƒŒƒXAƒGƒ‰[ŽžŠÔƒNƒŠƒA
	sub.erraddr = 0;
	sub.errtime = 0;

	// Š„‚èž‚ÝƒJƒEƒ“ƒgƒNƒŠƒA
	for (i=0; i<8; i++) {
		sub.intreq[i] = 0;
		sub.intack[i] = 0;
	}

	// ƒƒ‚ƒŠƒRƒ“ƒeƒLƒXƒgì¬(ƒŠƒZƒbƒgê—p)
	memory->MakeContext(TRUE);

	// ƒŠƒZƒbƒg
	::s68000reset();
	::s68000context.resethandler = cpu_resethandler;
	::s68000context.odometer = 0;

	// Š„‚èž‚Ý‚ð‚·‚×‚ÄŽæ‚èÁ‚·
	::s68000GetContext(&context);
	for (i=1; i<=7; i++) {
		bit = (1 << i);
		if (context.interrupts[0] & bit) {
			context.interrupts[0] &= (BYTE)(~bit);
			context.interrupts[i] = 0;
		}
	}
	::s68000SetContext(&context);

	// ƒƒ‚ƒŠƒRƒ“ƒeƒLƒXƒgì¬(’Êí)
	memory->MakeContext(FALSE);
}

//---------------------------------------------------------------------------
//
//	ƒZ[ƒu
//
//---------------------------------------------------------------------------
BOOL FASTCALL CPU::Save(Fileio *fio, int /*ver*/)
{
	size_t sz;
	cpu_t cpu;

	ASSERT(this);
	ASSERT(fio);

	LOG0(Log::Normal, "ƒZ[ƒu");

	// ƒRƒ“ƒeƒLƒXƒgŽæ“¾
	GetCPU(&cpu);

	// ƒTƒCƒY‚ðƒZ[ƒu
	sz = sizeof(cpu_t);
	if (!fio->Write(&sz, sizeof(sz))) {
		return FALSE;
	}

	// ŽÀ‘Ì‚ðƒZ[ƒu
	if (!fio->Write(&cpu, (int)sz)) {
		return FALSE;
	}

	// ƒTƒCƒY‚ðƒZ[ƒu(ƒTƒu)
	sz = sizeof(cpusub_t);
	if (!fio->Write(&sz, sizeof(sz))) {
		return FALSE;
	}

	// ŽÀ‘Ì‚ðƒZ[ƒu(ƒTƒu)
	if (!fio->Write(&sub, (int)sz)) {
		return FALSE;
	}

	return TRUE;
}

//---------------------------------------------------------------------------
//
//	ƒ[ƒh
//
//---------------------------------------------------------------------------
BOOL FASTCALL CPU::Load(Fileio *fio, int /*ver*/)
{
	cpu_t cpu;
	size_t sz;

	ASSERT(this);
	ASSERT(fio);

	LOG0(Log::Normal, "ƒ[ƒh");

	// ƒTƒCƒY‚ðƒ[ƒhAÆ‡
	if (!fio->Read(&sz, sizeof(sz))) {
		return FALSE;
	}
	if (sz != sizeof(cpu_t)) {
		return FALSE;
	}

	// ŽÀ‘Ì‚ðƒ[ƒh
	if (!fio->Read(&cpu, (int)sz)) {
		return FALSE;
	}

	// “K—p(ƒŠƒZƒbƒg‚µ‚Ä‚©‚çs‚¤)
	memory->MakeContext(TRUE);
	::s68000reset();
	memory->MakeContext(FALSE);
	SetCPU(&cpu);

	// ƒTƒCƒY‚ðƒ[ƒhAÆ‡(ƒTƒu)
	if (!fio->Read(&sz, sizeof(sz))) {
		return FALSE;
	}
	if (sz != sizeof(cpusub_t)) {
		return FALSE;
	}

	// ŽÀ‘Ì‚ðƒ[ƒh(ƒTƒu)
	if (!fio->Read(&sub, (int)sz)) {
		return FALSE;
	}

	return TRUE;
}

