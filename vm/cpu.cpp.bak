//---------------------------------------------------------------------------
//
//	CPUƒŒƒWƒXƒ^Žæ“¾
//
//---------------------------------------------------------------------------
void FASTCALL CPU::GetCPU(cpu_t *buffer) const
{
	int i;

	ASSERT(this);
	ASSERT(buffer);

	// Dreg, Areg
	for (i=0; i<8; i++) {
		buffer->dreg[i] = ::s68000context.dreg[i];
		buffer->areg[i] = ::s68000context.areg[i];
	}

	// Š„‚èž‚Ý
	for (i=0; i<8; i++) {
		buffer->intr[i] = (DWORD)::s68000context.interrupts[i];
		buffer->intreq[i] = sub.intreq[i];
		buffer->intack[i] = sub.intack[i];
	}

	// ‚»‚Ì‘¼
	buffer->sp = ::s68000context.asp;
	buffer->pc = ::s68000context.pc;
	buffer->sr = (DWORD)::s68000context.sr;
	buffer->odd = ::s68000context.odometer;
}

//---------------------------------------------------------------------------
//
//	CPUƒŒƒWƒXƒ^Ý’è
//
//---------------------------------------------------------------------------
void FASTCALL CPU::SetCPU(const cpu_t *buffer)
{
	int i;
	S68000CONTEXT context;

	ASSERT(this);
	ASSERT(buffer);

	// ƒRƒ“ƒeƒLƒXƒgŽæ“¾
	::s68000GetContext(&context);

	// Dreg, Areg
	for (i=0; i<8; i++) {
		context.dreg[i] = buffer->dreg[i];
		context.areg[i] = buffer->areg[i];
	}

	// Š„‚èž‚Ý
	for (i=0; i<8; i++) {
		context.interrupts[i] = (BYTE)buffer->intr[i];
		sub.intreq[i] = buffer->intreq[i];
		sub.intack[i] = buffer->intack[i];
	}

	// ‚»‚Ì‘¼
	context.asp = buffer->sp;
	context.pc = buffer->pc;
	context.sr = (WORD)buffer->sr;
	context.odometer = buffer->odd;

	// ƒRƒ“ƒeƒLƒXƒgÝ’è
	::s68000SetContext(&context);
}

//---------------------------------------------------------------------------
//
//	Š„‚èž‚Ý
//
//---------------------------------------------------------------------------
BOOL FASTCALL CPU::Interrupt(int level, int vector)
{
	int ret;

	// INTERRUPT SWITCH‚É‚æ‚éNMIŠ„‚èž‚Ý‚ÍƒxƒNƒ^-1
	ASSERT(this);
	ASSERT((level >= 1) && (level <= 7));
	ASSERT(vector >= -1);

	// ƒŠƒNƒGƒXƒg
	ret = ::s68000interrupt(level, vector);

	// Œ‹‰Ê•]‰¿
	if (ret == 0) {
#if defined(CPU_LOG)
		LOG2(Log::Normal, "Š„‚èž‚Ý—v‹Žó— ƒŒƒxƒ‹%d ƒxƒNƒ^$%02X", level, vector);
#endif	// CPU_LOG
		sub.intreq[level]++;
		return TRUE;
	}

	return FALSE;
}

//---------------------------------------------------------------------------
//
//	Š„‚èž‚ÝACK
//
//---------------------------------------------------------------------------
void FASTCALL CPU::IntAck(int level)
{
	ASSERT(this);
	ASSERT((level >= 1) && (level <= 7));

#if defined(CPU_LOG)
	LOG1(Log::Normal, "Š„‚èž‚Ý—v‹ACK ƒŒƒxƒ‹%d", level);
#endif	// CPU_LOG

	// ƒJƒEƒ“ƒgƒAƒbƒv
	sub.intack[level]++;

	// Š„‚èž‚ÝƒŒƒxƒ‹•Ê
	switch (level) {
		// IOSC,SCSI(“à‘ )
		case 1:
			iosc->IntAck();
			scsi->IntAck(1);
			break;

		// MIDI,SCSI(ƒŒƒxƒ‹2)
		case 2:
			midi->IntAck(2);
			scsi->IntAck(2);
			break;

		// DMAC
		case 3:
			dmac->IntAck();
			break;

		// MIDI,SCSI(ƒŒƒxƒ‹4)
		case 4:
			midi->IntAck(4);
			scsi->IntAck(4);
			break;

		// SCC
		case 5:
			scc->IntAck();
			break;

		// MFP
		case 6:
			mfp->IntAck();
			break;

		// ‚»‚Ì‘¼
		default:
			break;
	}
}

//---------------------------------------------------------------------------
//
//	Š„‚èž‚ÝƒLƒƒƒ“ƒZƒ‹
//
//---------------------------------------------------------------------------
void FASTCALL CPU::IntCancel(int level)
{
	S68000CONTEXT context;
	DWORD bit;

	ASSERT(this);
	ASSERT((level >= 1) && (level <= 7));

	// ƒRƒ“ƒeƒLƒXƒg‚ð’¼Ú‘‚«Š·‚¦‚é
	::s68000GetContext(&context);

	// ŠY“–ƒrƒbƒg‚ªƒIƒ“‚È‚ç
	bit = (1 << level);
	if (context.interrupts[0] & bit) {
#if defined(CPU_LOG)
		LOG1(Log::Normal, "Š„‚èž‚ÝƒLƒƒƒ“ƒZƒ‹ ƒŒƒxƒ‹%d", level);
#endif	// CPU_LOG

		// ƒrƒbƒg‚ð~‚ë‚·
		context.interrupts[0] &= (BYTE)(~bit);

		// ƒxƒNƒ^‚Í0
		context.interrupts[level] = 0;

		// ƒŠƒNƒGƒXƒg‚ð‰º‚°‚é
		sub.intreq[level]--;
	}

	// ƒRƒ“ƒeƒLƒXƒg‚ð‘‚«ž‚Þ
	::s68000SetContext(&context);
}

//---------------------------------------------------------------------------
//
//	RESET–½—ß
//
//---------------------------------------------------------------------------
void FASTCALL CPU::ResetInst()
{
	Device *device;

	ASSERT(this);
	LOG0(Log::Detail, "RESET–½—ß");

	// ƒƒ‚ƒŠ‚ðŽæ“¾
	device = (Device*)vm->SearchDevice(MAKEID('M', 'E', 'M', ' '));
	ASSERT(device);

	// ƒƒ‚ƒŠƒfƒoƒCƒX‚É‘Î‚µ‚Ä‚·‚×‚ÄƒŠƒZƒbƒg‚ð‚©‚¯‚Ä‚¨‚­
	// ³Šm‚É‚ÍACPU‚ÌRESETM†‚ª‚Ç‚±‚Ü‚Å“`‚í‚Á‚Ä‚¢‚é‚©‚É‚æ‚é
	while (device) {
		device->Reset();
		device = device->GetNextDevice();
	}
}

//---------------------------------------------------------------------------
//
//	ƒoƒXƒGƒ‰[
//	¦DMA“]‘—‚É‚æ‚éƒoƒXƒGƒ‰[‚à‚±‚±‚É—ˆ‚é
//	¦CPUƒRƒA“à•”‚ÅƒoƒXƒGƒ‰[‚Æ”»’è‚µ‚½ê‡‚ÍA‚±‚±‚ðŒo—R‚µ‚È‚¢
//
//---------------------------------------------------------------------------
void FASTCALL CPU::BusErr(DWORD addr, BOOL read)
{
	DWORD pc;
	DWORD stat;

	ASSERT(this);
	ASSERT(addr <= 0xffffff);

	// DMAC‚É“]‘—’†‚©•·‚­BDMAC’†‚È‚çDMAC‚É”C‚¹‚é
	if (dmac->IsDMA()) {
		dmac->BusErr(addr, read);
		return;
	}

	// ƒAƒhƒŒƒX‚ª‘O‰ñ‚ÌƒAƒhƒŒƒX+2‚ÅA‚©‚ÂŽžŠÔ‚ª“¯‚¶‚È‚ç–³Ž‹‚·‚é(LONGƒAƒNƒZƒX)
	if (addr == (sub.erraddr + 2)) {
		if (scheduler->GetTotalTime() == sub.errtime) {
			return;
		}
	}

	// ƒAƒhƒŒƒX‚ÆŽžŠÔ‚ðXV
	sub.erraddr = addr;
	sub.errtime = scheduler->GetTotalTime();

	// PCŽæ“¾(ŠY“––½—ß‚ÌƒIƒyƒR[ƒh‚ÉˆÊ’u‚·‚é)
	pc = GetPC();

	// “Ç‚Ýo‚µ(Word)
	stat = memory->ReadOnly(pc);
	stat <<= 8;
	stat |= memory->ReadOnly(pc + 1);
	stat <<= 16;

	// ƒtƒ@ƒ“ƒNƒVƒ‡ƒ“ƒR[ƒhì¬(í‚Éƒf[ƒ^ƒAƒNƒZƒX‚Æ‚Ý‚È‚·)
	stat |= 0x09;
	if (::s68000context.sr & 0x2000) {
		stat |= 0x04;
	}
	if (read) {
		stat |= 0x10;
	}

	// ƒoƒXƒGƒ‰[”­s
	::s68000buserr(addr, stat);
}

//---------------------------------------------------------------------------
//
//	ƒAƒhƒŒƒXƒGƒ‰[
//	¦DMA“]‘—‚É‚æ‚éƒAƒhƒŒƒXƒGƒ‰[‚à‚±‚±‚É—ˆ‚é
//	¦CPUƒRƒA“à•”‚ÅƒAƒhƒŒƒXƒGƒ‰[‚Æ”»’è‚µ‚½ê‡‚ÍA‚±‚±‚ðŒo—R‚µ‚È‚¢
//
//---------------------------------------------------------------------------
void FASTCALL CPU::AddrErr(DWORD addr, BOOL read)
{
	DWORD pc;
	DWORD stat;

	ASSERT(this);
	ASSERT(addr <= 0xffffff);
	ASSERT(addr & 1);

	// DMAC‚É“]‘—’†‚©•·‚­BDMAC’†‚È‚çDMAC‚É”C‚¹‚é
	if (dmac->IsDMA()) {
		dmac->AddrErr(addr, read);
		return;
	}

	// ƒAƒhƒŒƒX‚ª‘O‰ñ‚ÌƒAƒhƒŒƒX+2‚ÅA‚©‚ÂŽžŠÔ‚ª“¯‚¶‚È‚ç–³Ž‹‚·‚é(LONGƒAƒNƒZƒX)
	if (addr == (sub.erraddr + 2)) {
		if (scheduler->GetTotalTime() == sub.errtime) {
			return;
		}
	}

	// ƒAƒhƒŒƒX‚ÆŽžŠÔ‚ðXV
	sub.erraddr = addr;
	sub.errtime = scheduler->GetTotalTime();

	// PCŽæ“¾(ŠY“––½—ß‚ÌƒIƒyƒR[ƒh‚ÉˆÊ’u‚·‚é)
	pc = GetPC();

	// “Ç‚Ýo‚µ(Word)
	stat = memory->ReadOnly(pc);
	stat <<= 8;
	stat |= memory->ReadOnly(pc + 1);
	stat <<= 16;

	// ƒtƒ@ƒ“ƒNƒVƒ‡ƒ“ƒR[ƒhì¬(í‚Éƒf[ƒ^ƒAƒNƒZƒX‚Æ‚Ý‚È‚·)
	stat |= 0x8009;
	if (::s68000context.sr & 0x2000) {
		stat |= 0x04;
	}
	if (read) {
		stat |= 0x10;
	}

	// ƒoƒXƒGƒ‰[”­s(“à•”‚ÅƒAƒhƒŒƒXƒGƒ‰[‚Ö•ªŠò)
	::s68000buserr(addr, stat);
}

//---------------------------------------------------------------------------
//
//	ƒoƒXƒGƒ‰[‹L˜^
//	¦CPUƒRƒA“à•”‚ÅƒoƒXƒGƒ‰[‚Æ”»’è‚µ‚½ê‡‚àA‚±‚±‚ð’Ê‚é
//
//---------------------------------------------------------------------------
void FASTCALL CPU::BusErrLog(DWORD addr, DWORD stat)
{
	ASSERT(this);

	// •K‚¸ƒ}ƒXƒN(24bit‚ð’´‚¦‚éê‡‚ª‚ ‚é)
	addr &= 0xffffff;

	if (stat & 0x10) {
		LOG1(Log::Warning, "ƒoƒXƒGƒ‰[(“Ç‚Ýž‚Ý) $%06X", addr);
	}
	else {
		LOG1(Log::Warning, "ƒoƒXƒGƒ‰[(‘‚«ž‚Ý) $%06X", addr);
	}
}

//---------------------------------------------------------------------------
//
//	ƒAƒhƒŒƒXƒGƒ‰[‹L˜^
//	¦CPUƒRƒA“à•”‚ÅƒAƒhƒŒƒXƒGƒ‰[‚Æ”»’è‚µ‚½ê‡‚àA‚±‚±‚ð’Ê‚é
//
//---------------------------------------------------------------------------
void FASTCALL CPU::AddrErrLog(DWORD addr, DWORD stat)
{
	ASSERT(this);

	// •K‚¸ƒ}ƒXƒN(24bit‚ð’´‚¦‚éê‡‚ª‚ ‚é)
	addr &= 0xffffff;

	if (stat & 0x10) {
		LOG1(Log::Warning, "ƒAƒhƒŒƒXƒGƒ‰[(“Ç‚Ýž‚Ý) $%06X", addr);
	}
	else {
		LOG1(Log::Warning, "ƒAƒhƒŒƒXƒGƒ‰[(‘‚«ž‚Ý) $%06X", addr);
	}
}
