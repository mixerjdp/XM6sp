{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug XM6",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/00proj.vc7/Debug/XM6.exe",
      "args": [],
      "cwd": "${workspaceFolder}/00proj.vc7",
      "console": "integratedTerminal",
      "preLaunchTask": "Build XM6 (Debug)"
    },
    {
      "name": "Release XM6 (Sin depuración)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/00proj.vc7/Release/XM6.exe",
      "args": [],
      "cwd": "${workspaceFolder}/00proj.vc7",
      "console": "integratedTerminal",
      "preLaunchTask": "Build XM6 (Release)"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/sw/XM62026/mfc",
      "program": "c:/sw/XM62026/mfc/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}